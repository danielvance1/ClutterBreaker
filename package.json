{
  "name": "clutterbreaker",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "db:new": "dbmate --no-dump-schema new",
    "db:up": "dbmate --no-dump-schema up",
    "db:down": "dbmate --no-dump-schema rollback",
    "db:status": "dbmate --no-dump-schema status"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielvance1/ClutterBreaker.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/danielvance1/ClutterBreaker/issues"
  },
  "homepage": "https://github.com/danielvance1/ClutterBreaker#readme",
  "private": true,
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dbmate": "^2.36.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
